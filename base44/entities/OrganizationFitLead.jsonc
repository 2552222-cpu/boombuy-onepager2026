{
  "name": "OrganizationFitLead",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 session \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05db\u05e4\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea"
    },
    "orgSize": {
      "type": "string",
      "description": "\u05d8\u05d5\u05d5\u05d7 \u05de\u05e1\u05e4\u05e8 \u05d4\u05e2\u05d5\u05d1\u05d3\u05d9\u05dd"
    },
    "welfareState": {
      "type": "string",
      "description": "\u05de\u05e6\u05d1 \u05d4\u05e8\u05d5\u05d5\u05d7\u05d4 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "upgradeGoal": {
      "type": "string",
      "description": "\u05de\u05d8\u05e8\u05ea \u05d4\u05e9\u05d3\u05e8\u05d5\u05d2"
    },
    "fullName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "orgName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "consent": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05e1\u05db\u05de\u05d4 \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e7\u05e9\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "fit_completed",
        "calendar_opened",
        "meeting_booked"
      ],
      "default": "fit_completed",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05dc\u05d9\u05d3"
    }
  },
  "required": [
    "sessionId",
    "orgSize",
    "welfareState",
    "upgradeGoal",
    "status"
  ]
}